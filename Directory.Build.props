<Project>
  <PropertyGroup>
    <!-- The .NET SDK version is pinned in global.json; supported target frameworks live here. -->
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>

    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <NeutralLanguage>en</NeutralLanguage>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true' Or '$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

    <IsPackable Condition="'$(MSBuildProjectName)' == 'Prism.Events.Extensions'">true</IsPackable>
    <IsPackable Condition="'$(IsPackable)' == ''">false</IsPackable>
    <IsTestProject Condition="'$(MSBuildProjectName)' == 'Prism.Events.Extensions.Tests'">true</IsTestProject>
    <PackageOutputPath>$([System.IO.Path]::Combine('$(MSBuildThisFileDirectory)', 'artifacts', 'packages'))</PackageOutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsPackable)' == 'true'">
    <Authors>Azat Tazayan</Authors>
    <Copyright>Copyright © 2026-present Azat Tazayan</Copyright>
    <PackageProjectUrl>https://github.com/tazayan/Prism.Events.Extensions</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/tazayan/Prism.Events.Extensions.git</RepositoryUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>

    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>logo.png</PackageIcon>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <VersionPrefix>1.0.0</VersionPrefix>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Embed a portable PDB in the assembly; Source Link maps its documents to GitHub. -->
    <DebugSymbols>true</DebugSymbols>
    <DebugType>embedded</DebugType>
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="\" />
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" />
    <None Include="$([System.IO.Path]::Combine('$(MSBuildThisFileDirectory)', 'assets', 'logo.png'))"
          Pack="true"
          PackagePath="\" />
  </ItemGroup>

  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)xunit.runner.json"
          Link="xunit.runner.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
