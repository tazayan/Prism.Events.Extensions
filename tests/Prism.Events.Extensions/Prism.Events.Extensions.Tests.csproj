<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- xUnit.net v3 test projects are self-hosting Microsoft Testing Platform executables. -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <!-- Pin the latest platform version rather than the minimum that xunit.v3 depends on. -->
    <PackageReference Include="Microsoft.Testing.Platform" />
    <PackageReference Include="Microsoft.Testing.Platform.MSBuild" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Prism.Events.Extensions\Prism.Events.Extensions.csproj" />
  </ItemGroup>

</Project>
