<?xml version="1.0" encoding="utf-8"?>
<!-- Microsoft code coverage settings, passed with: dotnet test --coverage-settings <this file> -->
<Configuration>
  <CodeCoverage>
    <ModulePaths>
      <Include>
        <ModulePath>.*[\\/]Prism\.Events\.Extensions\.dll$</ModulePath>
      </Include>
    </ModulePaths>
    <Attributes>
      <Exclude>
        <Attribute>^System\.CodeDom\.Compiler\.GeneratedCodeAttribute$</Attribute>
        <Attribute>^System\.Diagnostics\.CodeAnalysis\.ExcludeFromCodeCoverageAttribute$</Attribute>
      </Exclude>
    </Attributes>
    <DeterministicReport>true</DeterministicReport>
  </CodeCoverage>
</Configuration>
